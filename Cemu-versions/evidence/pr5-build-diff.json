      "patch": "@@ -1,9 +1,9 @@\n-name: \"[Release] Cemu Windows ARM64\"\n+name: \"[Test_SE] Cemu Windows ARM64\"\n \n on:\n   push:\n     branches:\n-      - final-adreno-compat-arm64\n+      - build/test-se-once\n   workflow_dispatch:\n \n concurrency:\n@@ -24,11 +24,11 @@ jobs:\n         with:\n           submodules: recursive\n \n-      - name: Assert Release branch role\n+      - name: Assert Test_SE build carrier\n         shell: pwsh\n         run: |\n-          if (\"${{ github.ref }}\" -ne \"refs/heads/final-adreno-compat-arm64\") {\n-            throw \"Release workflow ran on unexpected ref: ${{ github.ref }}\"\n+          if (\"${{ github.ref }}\" -ne \"refs/heads/build/test-se-once\") {\n+            throw \"Test_SE build workflow ran on unexpected ref: ${{ github.ref }}\"\n           }\n           $guard = Get-Content 'ROLE_GUARD_RELEASE.txt' -Raw\n           foreach ($required in @(\n@@ -201,5 +201,5 @@ jobs:\n       - name: Upload artifact\n         uses: actions/upload-artifact@v6\n         with:\n-          name: cemu-arm64-release\n+          name: cemu-arm64-test-se-astra\n           path: ./bin/Cemu.exe"
