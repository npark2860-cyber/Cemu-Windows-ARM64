#version 450
layout(local_size_x=256) in;
layout(set=0,binding=0,rgba8) uniform readonly image2D frameA;
layout(set=0,binding=1,rgba8) uniform readonly image2D frameB;
layout(set=0,binding=3,std430) readonly buffer Output { uint words[]; } residual;
layout(set=0,binding=4,rgba8) uniform writeonly image2D composed;
#define STORE_PIXEL(pos,q) imageStore(composed,pos,vec4(clamp( \
    (imageLoad(frameA,pos).rgb+imageLoad(frameB,pos).rgb)*0.5 \
    +(q-128.0)*0.00330072408542037,0.0,1.0),1.0))
void main() {
    uint group=gl_GlobalInvocationID.x;
    if(group>=518400u) return;
    // Four RGB pixels occupy exactly three uint words. Load each word explicitly.
    // The prior dynamic byteAt helper produced first-word reuse at RGB boundaries
    // on the tested driver; the cause below SPIR-V is not independently proven.
    uint w0=residual.words[group*3u];
    uint w1=residual.words[group*3u+1u];
    uint w2=residual.words[group*3u+2u];
    vec3 r0=vec3(w0&255u,(w0>>8)&255u,(w0>>16)&255u);
    vec3 r1=vec3(w0>>24,w1&255u,(w1>>8)&255u);
    vec3 r2=vec3((w1>>16)&255u,w1>>24,w2&255u);
    vec3 r3=vec3((w2>>8)&255u,(w2>>16)&255u,w2>>24);
    uint pixel=group*4u;
    ivec2 xy=ivec2(pixel%1920u,pixel/1920u);
    // Diagnostic residual consumer. Synthetic inputs stand in for a prepared pair;
    // this is not motion estimation or validation of game interpolation quality.
    STORE_PIXEL(xy,r0);
    STORE_PIXEL(xy+ivec2(1,0),r1);
    STORE_PIXEL(xy+ivec2(2,0),r2);
    STORE_PIXEL(xy+ivec2(3,0),r3);
}
