+			uint32 vsSemanticId = LatteShaderPSInputTable::getVertexShaderOutParamSemanticId(shaderContext->contextRegisters, paramIndex);
+			if (psInputTable->getPSImportLocationBySemanticId(vsSemanticId) == psInputIndex)
+				return true;
