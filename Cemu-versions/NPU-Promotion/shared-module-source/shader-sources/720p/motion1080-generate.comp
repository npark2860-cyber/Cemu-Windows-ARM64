#version 450
layout(local_size_x=16,local_size_y=16) in;
layout(set=0,binding=0,rgba8) uniform writeonly image2D frameA;
layout(set=0,binding=1,rgba8) uniform writeonly image2D frameB;
layout(push_constant) uniform Params { uint phase; } pc;
uvec3 scene(ivec2 p,uint seed) {
    ivec2 b=ivec2(floor(vec2(p)/4.0));
    uint h=uint(b.x)*1664525u+uint(b.y)*1013904223u+seed*2246822519u;
    h^=h>>16; h*=2246822519u; h^=h>>13;
    return uvec3(h&255u,(h>>8)&255u,(h>>16)&255u);
}
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(p.x>=1280 || p.y>=720) return;
    ivec2 shift=pc.phase==1u?ivec2(8,4):(pc.phase==2u?ivec2(-12,8):ivec2(0));
    imageStore(frameA,p,vec4(vec3(scene(p,11u))/255.0,1));
    imageStore(frameB,p,vec4(vec3(scene(p-shift,pc.phase==3u?97u:11u))/255.0,1));
}
